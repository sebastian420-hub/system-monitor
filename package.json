{
  "name": "system-monitor",
  "version": "1.1.0",
  "description": "Low-power menu bar monitor for CPU, GPU and RAM usage",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sebastian420.systemmonitor",
    "productName": "System Monitor",
    "asar": true,
    "files": ["main.js", "preload.js", "index.html", "lib/**"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"],
      "extendInfo": { "LSUIElement": true }
    }
  }
}
